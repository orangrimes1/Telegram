# Copy this file to .env and fill in real values.
# Get bot tokens from @BotFather.

ONBOARD_BOT_TOKEN=
SUPPORT_BOT_TOKEN=

# The private admin group where the team handles credential creation and
# support escalations. Two forum topics: Request (onboarding notifications —
# device review, trial/paid credential requests) and Support (support bot
# tickets). Get the chat id by adding the bot to the group and checking an
# incoming update's chat.id (or use @userinfobot / @RawDataBot); get each
# topic's message_thread_id from an incoming message's ctx.message value.
ADMIN_GROUP_CHAT_ID=
ADMIN_REQUEST_TOPIC_ID=
ADMIN_SUPPORT_TOPIC_ID=

# PayLio static payment links, one per plan tier (device count), 12-month plan.
PAYLIO_LINK_1=
PAYLIO_LINK_2=
PAYLIO_LINK_3=

# Xtream Codes server URL sent alongside username/password at credential
# handoff (trial and paid). Leave blank to show a generic "ask the team" note.
XTREAM_SERVER_URL=

# Downloader app code for sideloading the Smarters Pro APK on Firestick /
# Android TV. Kept here (not hardcoded) since Amazon can force this to change.
SMARTERS_DOWNLOADER_CODE=

# LUMEN customer group invite link (join-request approval enabled), appended
# to the final paid 12-month credential handoff message. Leave blank to omit.
LUMEN_GROUP_INVITE_LINK=
